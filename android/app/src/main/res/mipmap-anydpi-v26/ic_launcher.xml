<?xml version="1.0" encoding="utf-8"?>
<!-- Адаптивная иконка Android: система сама обрежет её под форму,
     принятую на устройстве (круг, скруглённый квадрат и т. д.).
     Знак нарисован внутри центральных 66 из 108 единиц — безопасной
     зоны, которую не срежет никакая маска. -->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@color/ic_launcher_background"/>
    <foreground android:drawable="@mipmap/ic_launcher_foreground"/>
    <!-- Android 13+ перекрашивает иконки под обои, используя этот слой.
         Без него наша осталась бы единственной цветной среди остальных. -->
    <monochrome android:drawable="@mipmap/ic_launcher_monochrome"/>
</adaptive-icon>
